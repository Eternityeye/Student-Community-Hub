<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SocialReportMapper">

    <resultMap type="SocialReport" id="SocialReportResult">
        <result property="reportId"      column="report_id"      />
        <result property="postId"        column="post_id"        />
        <result property="userId"        column="user_id"        />
        <result property="reasonsStr"    column="reasons"        />
        <result property="description"   column="description"    />
        <result property="status"        column="status"         />
        <result property="handleBy"      column="handle_by"      />
        <result property="handleTime"    column="handle_time"    />
        <result property="handleResult"  column="handle_result"  />
        <result property="createTime"    column="create_time"    />
        <result property="reportUserName" column="report_user_name" />
        <result property="postContent"   column="post_content"   />
        <result property="postUserName"  column="post_user_name" />
    </resultMap>

    <sql id="selectReportVo">
        select
            sr.report_id,
            sr.post_id,
            sr.user_id,
            sr.reasons,
            sr.description,
            sr.status,
            sr.handle_by,
            sr.handle_time,
            sr.handle_result,
            sr.create_time,
            su.nick_name as report_user_name,
            sp.content as post_content,
            su2.nick_name as post_user_name
        from social_report sr
        left join sys_user su on sr.user_id = su.user_id
        left join social_post sp on sr.post_id = sp.post_id
        left join sys_user su2 on sp.user_id = su2.user_id
    </sql>

    <!-- 查询举报列表 -->
    <select id="selectReportList" parameterType="SocialReport" resultMap="SocialReportResult">
        <include refid="selectReportVo" />
        <where>
            <if test="status != null and status != ''">
                and sr.status = #{status}
            </if>
        </where>
        order by sr.create_time desc
    </select>

    <!-- 查询举报详情 -->
    <select id="selectReportById" parameterType="Long" resultMap="SocialReportResult">
        <include refid="selectReportVo" />
        where sr.report_id = #{reportId}
    </select>

    <!-- 新增举报 -->
    <insert id="insertReport" parameterType="SocialReport" useGeneratedKeys="true" keyProperty="reportId">
        insert into social_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="postId != null">post_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="reasonsStr != null">reasons,</if>
            <if test="description != null">description,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="postId != null">#{postId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="reasonsStr != null">#{reasonsStr},</if>
            <if test="description != null">#{description},</if>
            sysdate()
        </trim>
    </insert>

    <!-- 修改举报 -->
    <update id="updateReport" parameterType="SocialReport">
        update social_report
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="handleBy != null">handle_by = #{handleBy},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="handleResult != null">handle_result = #{handleResult},</if>
        </set>
        where report_id = #{reportId}
    </update>

</mapper>

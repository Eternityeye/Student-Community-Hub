<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SocialLikeMapper">

    <resultMap type="SocialLike" id="SocialLikeResult">
        <result property="likeId"     column="like_id"     />
        <result property="postId"     column="post_id"     />
        <result property="userId"     column="user_id"     />
        <result property="createTime" column="create_time" />
    </resultMap>

    <!-- 查询是否点赞 -->
    <select id="selectLikeByPostAndUser" resultMap="SocialLikeResult">
        select like_id, post_id, user_id, create_time
        from social_like
        where post_id = #{postId} and user_id = #{userId}
    </select>

    <!-- 新增点赞 -->
    <insert id="insertLike" parameterType="SocialLike">
        insert into social_like (post_id, user_id, create_time)
        values (#{postId}, #{userId}, sysdate())
    </insert>

    <!-- 删除点赞 -->
    <delete id="deleteLikeByPostAndUser">
        delete from social_like where post_id = #{postId} and user_id = #{userId}
    </delete>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SocialCommentMapper">

    <resultMap type="SocialComment" id="SocialCommentResult">
        <result property="commentId"     column="comment_id"     />
        <result property="postId"        column="post_id"        />
        <result property="userId"        column="user_id"        />
        <result property="parentId"      column="parent_id"      />
        <result property="replyToUserId" column="reply_to_user_id" />
        <result property="content"       column="content"        />
        <result property="imagesStr"     column="images_str"     />
        <result property="status"        column="status"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="userName"      column="user_name"      />
        <result property="userAvatar"    column="user_avatar"    />
        <result property="replyToUserName" column="reply_to_user_name" />
    </resultMap>

    <sql id="selectCommentVo">
        select
            sc.comment_id,
            sc.post_id,
            sc.user_id,
            sc.parent_id,
            sc.reply_to_user_id,
            sc.content,
            sc.images as images_str,
            sc.status,
            sc.create_by,
            sc.create_time,
            sc.update_by,
            sc.update_time,
            su.nick_name as user_name,
            su.avatar as user_avatar,
            su2.nick_name as reply_to_user_name
        from social_comment sc
        left join sys_user su on sc.user_id = su.user_id
        left join sys_user su2 on sc.reply_to_user_id = su2.user_id
    </sql>

    <!-- 查询评论列表 -->
    <select id="selectCommentList" parameterType="SocialComment" resultMap="SocialCommentResult">
        <include refid="selectCommentVo" />
        <where>
            <if test="status != null and status != ''">
                and sc.status = #{status}
            </if>
            <if test="postId != null">
                and sc.post_id = #{postId}
            </if>
            <if test="parentId != null">
                and sc.parent_id = #{parentId}
            </if>
        </where>
        order by sc.create_time asc
    </select>

    <!-- 查询评论详情 -->
    <select id="selectCommentById" parameterType="Long" resultMap="SocialCommentResult">
        <include refid="selectCommentVo" />
        where sc.comment_id = #{commentId}
    </select>

    <!-- 新增评论 -->
    <insert id="insertComment" parameterType="SocialComment" useGeneratedKeys="true" keyProperty="commentId">
        insert into social_comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="postId != null">post_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="replyToUserId != null">reply_to_user_id,</if>
            <if test="content != null">content,</if>
            <if test="imagesStr != null">images,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="postId != null">#{postId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="replyToUserId != null">#{replyToUserId},</if>
            <if test="content != null">#{content},</if>
            <if test="imagesStr != null">#{imagesStr},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <!-- 修改评论 -->
    <update id="updateComment" parameterType="SocialComment">
        update social_comment
        <set>
            <if test="content != null">content = #{content},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where comment_id = #{commentId}
    </update>

    <!-- 删除评论 -->
    <delete id="deleteCommentById" parameterType="Long">
        delete from social_comment where comment_id = #{commentId}
    </delete>

    <!-- 查询帖子的评论（最新的，支持分页） -->
    <select id="selectCommentsByPostId" resultMap="SocialCommentResult">
        <include refid="selectCommentVo" />
        where sc.post_id = #{postId} and sc.status = '0' and sc.parent_id is null
        order by sc.create_time desc
        limit #{limit}
    </select>

    <!-- 查询帖子的所有评论及回复 -->
    <select id="selectAllCommentsByPostId" resultMap="SocialCommentResult">
        <include refid="selectCommentVo" />
        where sc.post_id = #{postId} and sc.status = '0'
        order by sc.parent_id asc, sc.create_time asc
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DisputeCaseMapper">

    <resultMap type="DisputeCase" id="DisputeCaseResult">
        <result property="caseId" column="case_id"/>
        <result property="taskId" column="task_id"/>
        <result property="taskTitle" column="task_title"/>
        <result property="plaintiffId" column="plaintiff_id"/>
        <result property="plaintiffName" column="plaintiff_name"/>
        <result property="plaintiffAvatar" column="plaintiff_avatar"/>
        <result property="defendantId" column="defendant_id"/>
        <result property="defendantName" column="defendant_name"/>
        <result property="defendantAvatar" column="defendant_avatar"/>
        <result property="reason" column="reason"/>
        <result property="plaintiffDescription" column="plaintiff_description"/>
        <result property="defendantDescription" column="defendant_description"/>
        <result property="plaintiffEvidenceImages" column="plaintiff_evidence_images"/>
        <result property="defendantEvidenceImages" column="defendant_evidence_images"/>
        <result property="status" column="status"/>
        <result property="handlerId" column="handler_id"/>
        <result property="handlerName" column="handler_name"/>
        <result property="handleReason" column="handle_reason"/>
        <result property="handleTime" column="handle_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectDisputeCaseVo">
        select dc.case_id, dc.task_id, rt.title as task_title,
               dc.plaintiff_id, up.user_name as plaintiff_name, up.avatar as plaintiff_avatar,
               dc.defendant_id, ud.user_name as defendant_name, ud.avatar as defendant_avatar,
               dc.reason, dc.plaintiff_description, dc.defendant_description,
               dc.plaintiff_evidence_images, dc.defendant_evidence_images,
               dc.status, dc.handler_id, uh.user_name as handler_name,
               dc.handle_reason, dc.handle_time,
               dc.create_by, dc.create_time, dc.update_by, dc.update_time
        from dispute_case dc
        left join reward_task rt on dc.task_id = rt.task_id
        left join sys_user up on dc.plaintiff_id = up.user_id
        left join sys_user ud on dc.defendant_id = ud.user_id
        left join sys_user uh on dc.handler_id = uh.user_id
    </sql>

    <!-- 分页查询纠纷列表 -->
    <select id="selectDisputeList" resultMap="DisputeCaseResult">
        <include refid="selectDisputeCaseVo"/>
        where 1=1
        <if test="userId != null">
            and (dc.plaintiff_id = #{userId} or dc.defendant_id = #{userId})
        </if>
        <if test="status != null and status != ''">
            and dc.status = #{status}
        </if>
        <if test="roleType != null and roleType != ''">
            <if test="roleType == 'plaintiff'">
                and dc.plaintiff_id = #{userId}
            </if>
            <if test="roleType == 'defendant'">
                and dc.defendant_id = #{userId}
            </if>
        </if>
        order by dc.create_time desc
    </select>

    <!-- 查询某个任务的纠纷 -->
    <select id="selectByTaskId" resultMap="DisputeCaseResult">
        <include refid="selectDisputeCaseVo"/>
        where dc.task_id = #{taskId}
        order by dc.create_time desc
    </select>

    <!-- 获取纠纷详情 -->
    <select id="selectDetailById" resultMap="DisputeCaseResult">
        <include refid="selectDisputeCaseVo"/>
        where dc.case_id = #{caseId}
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CreditLogMapper">

    <resultMap type="CreditLog" id="CreditLogResult">
        <result property="logId" column="log_id"/>
        <result property="userId" column="user_id"/>
        <result property="changeType" column="change_type"/>
        <result property="changeScore" column="change_score"/>
        <result property="relatedId" column="related_id"/>
        <result property="reason" column="reason"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 查询用户信誉历史 -->
    <select id="selectByUserId" resultMap="CreditLogResult">
        select log_id, user_id, change_type, change_score, related_id, reason, create_time
        from credit_log
        where user_id = #{userId}
        order by create_time desc
        limit 10
    </select>

</mapper>

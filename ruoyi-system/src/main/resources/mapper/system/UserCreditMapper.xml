<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.UserCreditMapper">

    <resultMap type="UserCredit" id="UserCreditResult">
        <result property="creditId" column="credit_id"/>
        <result property="userId" column="user_id"/>
        <result property="creditScore" column="credit_score"/>
        <result property="disputeCount" column="dispute_count"/>
        <result property="banUntil" column="ban_until"/>
        <result property="banReason" column="ban_reason"/>
        <result property="lastUpdate" column="last_update"/>
    </resultMap>

    <!-- 根据用户ID查询信誉信息 -->
    <select id="selectByUserId" resultMap="UserCreditResult">
        select credit_id, user_id, credit_score, dispute_count, ban_until, ban_reason, last_update
        from user_credit
        where user_id = #{userId}
    </select>

    <!-- 初始化用户信誉信息 -->
    <insert id="insertDefault">
        insert into user_credit (user_id, credit_score, dispute_count, ban_until, ban_reason, last_update)
        values (#{userId}, 100, 0, null, null, now())
    </insert>

</mapper>
